# Copy to .env.dev and fill in. .env.dev is gitignored.

# Files written into the bind-mounted ./data (rendered tiles) get this ownership.
# Set to your own `id -u` / `id -g`.
UID=1000
GID=1000

# --- Host ports (dev) ---
FRONT_PORT=9020
API_PORT=9021
CH_HTTP_PORT=9023
CH_NATIVE_PORT=9024

# --- Frontend ---
FRONTEND_TARGET=development
FRONTEND_COMMAND=npm run dev
NUXT_PUBLIC_API_BASE_URL=http://localhost:9021
# Server-side (SSR) only — inside the compose network the API is reachable by
# service name, not by the browser-facing localhost URL above.
API_INTERNAL_BASE_URL=http://api:4000
NUXT_PUBLIC_MAPBOX_TOKEN=
NUXT_PUBLIC_VERSION=0.1

# --- Data paths (inside containers; ./data is mounted at /opt/data) ---
OISST_NC_DIR=/opt/data
OISST_IMAGE_DIR=/opt/data/images

# --- ClickHouse ---
CH_HOST=db-ch
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=enso
CLICKHOUSE_PASSWORD=

# Point api/process at a remote ClickHouse instead of the local db-ch service
CH_USE_REMOTE=false
CH_REMOTE_URL=
CH_REMOTE_USER=
CH_REMOTE_PASSWORD=
