# Copy to .env.prod and fill in. .env.prod is gitignored (.env.* except
# .env.example), and it now holds a real ClickHouse password — keep it off the
# host's world-readable paths: chmod 600 .env.prod.
#
# Every compose invocation needs it explicitly:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# The UID/GID that owns DATA_DIR and CH_DATA_DIR on the host. `api` and
# `process` run as this, so a mismatch is a permission error on the archive,
# not a fallback.
UID=1000
GID=1000

# --- Host ports (only these two are published; db-ch is internal) ---
FRONT_PORT=9020
API_PORT=9021
# Used only if the db-ch ports block in the compose file is uncommented.
# CH_HTTP_PORT=9023
# CH_NATIVE_PORT=9024

# --- Frontend ---
FRONTEND_TARGET=production
# The built Nitro server, not `nuxt preview`.
FRONTEND_COMMAND=node .output/server/index.mjs
# What the BROWSER fetches. Public origin, reverse-proxy path included.
NUXT_PUBLIC_API_BASE_URL=https://mhw.cioospacificlabs.ca/api
# What the Nitro server fetches during SSR — service name on the compose
# network. Setting this to the public URL above is the classic ECONNREFUSED.
API_INTERNAL_BASE_URL=http://api:9021
NUXT_PUBLIC_MAPBOX_TOKEN=
NUXT_PUBLIC_VERSION=0.1

# --- Storage ---
# The full archive is ~163 GB (153 GB CoralTemp SST, 9.7 GB MHW, 1.6 GB
# climatology) plus the rendered image cache, and ClickHouse is ~85 GB of
# sst_daily and ~a further chunk of mhw_daily. Neither belongs in the repo
# checkout on a production box.
# Create these and chown them to UID:GID before the first `up`. Docker creates
# a missing bind source as root, which surfaces as an empty archive rather than
# as a permission error.
DATA_DIR=/home/taimaz/Projects/enso/data
CH_DATA_DIR=/home/taimaz/Projects/enso/clickhouse/data
CH_LOG_DIR=/home/taimaz/Projects/enso/clickhouse/logs

# --- Data paths (inside the containers; DATA_DIR is mounted at /opt/data) ---
OISST_NC_DIR=/opt/data/sst
OISST_IMAGE_DIR=/opt/data/images
CRW_CLIM_DIR=/opt/data/climatology
CRW_MHW_DIR=/opt/data/MHW

# --- ClickHouse ---
# Pinned, not :latest — a surprise major upgrade against a 100 GB data
# directory is not a thing to discover on a `pull`.
CH_IMAGE_TAG=25.8
CH_HOST=db-ch
CH_PORT=8123
CH_USER=default
CH_DATABASE=enso
# Required. api and process fall back to this for CH_PASSWORD.
CLICKHOUSE_PASSWORD=Jrts740o4i64
CH_PASSWORD=Jrts740o4i64

# Point api/process at a managed ClickHouse instead of the db-ch service
CH_USE_REMOTE=false
CH_REMOTE_URL=
CH_REMOTE_USER=
CH_REMOTE_PASSWORD=

# --- API ---
# Separate processes, so the per-thread ClickHouse client is unaffected by the
# count. An unrendered monthly bucket costs ~8.7 s and playback prefetches 8
# frames at a time, so one worker stalls unrelated requests behind it.
API_WORKERS=4